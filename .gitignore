agent-ctx/

# Tarball is regenerated by scripts/pack_medreader.sh — don't commit binaries
/download/deploy/medreader.tar.gz

# Local prompt files + screenshots uploaded by the user during dev
# (the IM gateway saves them to /home/z/my-project/upload/). Top-level
# only — must NOT match `src/app/api/upload/` (the PDF upload route).
/upload/
# NOTE: do NOT add `upload/` (no leading slash) here — it would also
# match `src/app/api/upload/` and silently break the PDF upload route.
# The user-uploads directory is already covered by `/uploads/` above.