                const res = await fetch(DEEPSEEK_API_URL, \{\
                    method: "POST",\
                    headers: \{ "Content-Type": "application/json", "Authorization": `Bearer $\{DEEPSEEK_API_KEY\}` \},\
                    body: JSON.stringify(\{\
                        model: "deepseek-chat",\
                        messages: [\
                            \{ \
                                role: "system", \
                                content: `\uc0\u20320 \u26159 \u19968 \u20010 \u39030 \u23574 \u30340 \u22522 \u30784 \u21307 \u23398 \u25991 \u29486 \u20998 \u26512 \u19987 \u23478 \u12290 \u35831 \u20998 \u26512 \u20197 \u19979 \u25991 \u29486 \u25991 \u26412 \u65292 \u24182 \u20005 \u26684 \u25353 \u29031 \u20197 \u19979 6\u20010 \u32500 \u24230 \u25552 \u21462 \u36923 \u36753 \u22823 \u32434 \u65306 \
                                1. \uc0\u31185 \u23398 \u38382 \u39064 \u22914 \u20309 \u25552 \u20986 \u21450 \u24847 \u20041 \
                                2. \uc0\u36923 \u36753 \u19978 \u22914 \u20309 \u35777 \u26126 \u31185 \u23398 \u38382 \u39064 \
                                3. \uc0\u20851 \u38190 \u30340 \u23454 \u39564 \u25216 \u26415 \
                                4. \uc0\u36923 \u36753 \u38142 \u25509 \u30340 \u20851 \u38190 \u28857 \
                                5. \uc0\u36923 \u36753 \u24635 \u32467 \
                                6. \uc0\u34893 \u29983 \u30340 \u35838 \u39064 \
                                \
                                \uc0\u35201 \u27714 \u36820 \u22238 JSON\u25968 \u32452 \u26684 \u24335 \u65292 \u22823 \u26631 \u39064 \u19979 \u21253 \u21547 \u23567 \u26631 \u39064 \u65292 \u24182 \u25552 \u21462 \u29992 \u20110 \u21407 \u25991 \u23450 \u20301 \u30340 \u33521 \u25991 \u20851 \u38190 \u35789 \u12290 \
                                \uc0\u26684 \u24335 \u31034 \u20363 \u65306 \
                                [\
                                  \{\
                                    "title": "1. \uc0\u31185 \u23398 \u38382 \u39064 \u22914 \u20309 \u25552 \u20986 \u21450 \u24847 \u20041 ",\
                                    "children": [\
                                      \{"title": "\uc0\u31185 \u23398 \u38382 \u39064 \u30340 \u25552 \u20986 ", "keyword": "Parity and Lactation"\},\
                                      \{"title": "\uc0\u31185 \u23398 \u24847 \u20041 ", "keyword": "immune surveillance"\}\
                                    ]\
                                  \}\
                                ]\
                                \uc0\u21482 \u36820 \u22238 JSON\u65292 \u19981 \u35201 \u22810 \u20313 \u25991 \u26412 \u12290 `\
                            \},\
                            \{ role: "user", content: textForAnalysis \}\
                        ],\
                        temperature: 0.2\
                    \})\
                \});\
                const data = await res.json();\
                const content = data.choices[0].message.content;\
                \
                const jsonStr = content.substring(content.indexOf('['), content.lastIndexOf(']') + 1);\
                const outline = JSON.parse(jsonStr);\
                \
                renderOutline(outline);\
                addChatMessage('agent', '\uc0\u28145 \u24230 \u36923 \u36753 \u35299 \u26512 \u23436 \u27605 \u65292 \u24050 \u26174 \u31034 \u22312 \u24038 \u20391 \u12290 \u24744 \u21487 \u20197 \u23637 \u24320 \u24182 \u28857 \u20987 \u23567 \u26631 \u39064 \u22312 \u21407 \u25991 \u20013 \u23450 \u20301 \u65281 ');\
            \} catch (err) \{\
                document.getElementById('outline-container').innerHTML = '<span style="color:red;">\uc0\u22823 \u32434 \u29983 \u25104 \u22833 \u36133 \u65292 \u35831 \u30452 \u25509 \u21521  Agent \u25552 \u38382 \u12290 </span>';\
                addChatMessage('agent', '\uc0\u22823 \u32434 \u29983 \u25104 \u22833 \u36133 \u65292 \u20294 \u25105 \u24050 \u35760 \u24405 \u20840 \u25991 \u65292 \u24744 \u21487 \u20197 \u30452 \u25509 \u21521 \u25105 \u25552 \u38382 \u12290 ');\
            \}\
        \}\
\
        function renderOutline(outline) \{\
            const container = document.getElementById('outline-container');\
            container.innerHTML = '';\
            \
            outline.forEach(group => \{\
                const groupHtml = `\
                    <div class="outline-group">\
                        <div class="outline-header" onclick="this.parentElement.classList.toggle('collapsed')">\
                            <div class="arrow"></div>\
                            <span>$\{group.title\}</span>\
                        </div>\
                        <div class="outline-children">\
                            $\{group.children.map(child => `\
                                <div class="outline-sub" onclick="jumpToText('$\{child.keyword\}')">$\{child.title\}</div>\
                            `).join('')\}\
                        </div>\
                    </div>\
                `;\
                container.insertAdjacentHTML('beforeend', groupHtml);\
            \});\
        \}\
\
        // --- 5. \uc0\u21407 \u25991 \u36339 \u36716 \u19982 \u39640 \u20142  ---\
        function jumpToText(keyword) \{\
            if (!keyword) return;\
            const spans = document.querySelectorAll('.text-layer span');\
            const lowerKey = keyword.toLowerCase();\
            let found = false;\
            \
            // \uc0\u31227 \u38500 \u20043 \u21069 \u30340 \u39640 \u20142 \
            document.querySelectorAll('.text-layer span.highlight').forEach(s => s.classList.remove('highlight'));\
            \
            for (let span of spans) \{\
                if (span.textContent.toLowerCase().includes(lowerKey)) \{\
                    span.scrollIntoView(\{ behavior: 'smooth', block: 'center' \});\
                    span.classList.add('highlight');\
                    found = true;\
                    break;\
                \}\
            \}\
            \
            if (!found) \{\
                // \uc0\u22914 \u26524 \u25214 \u19981 \u21040 \u23436 \u25972 \u20851 \u38190 \u35789 \u65292 \u23581 \u35797 \u25353 \u21333 \u35789 \u25286 \u20998 \u25628 \u32034 \
                const words = keyword.split(' ');\
                for (let word of words) \{\
                    if (word.length < 4) continue;\
                    for (let span of spans) \{\
                        if (span.textContent.toLowerCase().includes(word.toLowerCase())) \{\
                            span.scrollIntoView(\{ behavior: 'smooth', block: 'center' \});\
                            span.classList.add('highlight');\
                            found = true;\
                            break;\
                        \}\
                    \}\
                    if (found) break;\
                \}\
            \}\
\
            if (!found) \{\
                alert("\uc0\u26410 \u22312 \u24403 \u21069 \u21152 \u36733 \u30340 \u39029 \u38754 \u20013 \u25214 \u21040 \u20851 \u38190 \u35789 : " + keyword);\
            \}\
        \}\
\
        // --- 6. Agent \uc0\u32842 \u22825 \u36923 \u36753  ---\
        function addChatMessage(role, text, imageUrl = null) \{\
            const panel = document.getElementById('chat-panel');\
            if (panel.querySelector('.empty-state')) panel.innerHTML = '';\
            \
            let imgHtml = imageUrl ? `<img src="$\{imageUrl\}" class="chat-image-preview">` : '';\
            const msgHtml = `\
                <div class="chat-message $\{role\}">\
                    $\{role === 'user' ? imgHtml : ''\}\
                    <div class="chat-bubble">$\{text\}</div>\
                </div>\
            `;\
            panel.insertAdjacentHTML('beforeend', msgHtml);\
            panel.scrollTop = panel.scrollHeight;\
        \}\
\
        async function sendChatMessage() \{\
            const input = document.getElementById('chat-input');\
            const text = input.value.trim();\
            if (!text && !capturedImageBase64) return;\
\
            const userMsg = text || "(\uc0\u38024 \u23545 \u26694 \u36873 \u30340 \u22270 \u34920 \u25552 \u38382 )";\
            addChatMessage('user', userMsg, capturedImageBase64);\
            \
            const currentImage = capturedImageBase64;\
            input.value = '';\
            clearImagePreview();\
\
            const panel = document.getElementById('chat-panel');\
            const loadingId = 'load-' + Date.now();\
            panel.insertAdjacentHTML('beforeend', `\
                <div class="chat-message agent" id="$\{loadingId\}">\
                    <div class="chat-bubble loading-dots"><span></span><span></span><span></span> \uc0\u24605 \u32771 \u20013 ...</div>\
                </div>\
            `);\
            panel.scrollTop = panel.scrollHeight;\
\
            try \{\
                const contextText = fullTextContent.substring(0, 8000);\
                let systemContent = `\uc0\u20320 \u26159 \u19968 \u20010 \u21307 \u23398 \u29983 \u31185 \u30740 \u21161 \u25163 \u12290 \u29992 \u25143 \u27491 \u22312 \u38405 \u35835 \u19968 \u31687 \u25991 \u29486 \u65292 \u20197 \u19979 \u26159 \u25991 \u29486 \u30340 \u21069 \u21322 \u37096 \u20998 \u25991 \u26412 \u65306 \\n\\n"""$\{contextText\}"""\\n\\n\u35831 \u22522 \u20110 \u27492 \u19978 \u19979 \u25991 \u22238 \u31572 \u38382 \u39064 \u12290 `;\
                \
                // \uc0\u27169 \u25311 \u22810 \u27169 \u24577 \u65306 \u30001 \u20110  DeepSeek API \u21487 \u33021 \u19981 \u25903 \u25345 \u22270 \u29255 \u65292 \u36825 \u37324 \u36890 \u36807 \u25991 \u23383 \u25552 \u31034  Agent \u29992 \u25143 \u19978 \u20256 \u20102 \u22270 \u29255 \
                if (currentImage) \{\
                    systemContent += `\\n\uc0\u29992 \u25143 \u25130 \u21462 \u20102 \u25991 \u29486 \u20013 \u30340 \u19968 \u24352 \u22270 \u34920 \u25110 \u29255 \u27573 \u65292 \u35831 \u20551 \u35774 \u20320 \u33021 \u30475 \u21040 \u23427 \u65292 \u24182 \u26681 \u25454 \u19978 \u19979 \u25991 \u24341 \u23548 \u29992 \u25143 \u20998 \u26512 \u12290 \u22914 \u26524 \u26080 \u27861 \u30830 \u23450 \u22270 \u34920 \u32454 \u33410 \u65292 \u35831 \u35753 \u29992 \u25143 \u25551 \u36848 \u22270 \u34920 \u20869 \u23481 \u12290 `;\
                \}\
\
                const res = await fetch(DEEPSEEK_API_URL, \{\
                    method: "POST",\
                    headers: \{ "Content-Type": "application/json", "Authorization": `Bearer $\{DEEPSEEK_API_KEY\}` \},\
                    body: JSON.stringify(\{\
                        model: "deepseek-chat",\
                        messages: [\
                            \{ role: "system", content: systemContent \},\
                            \{ role: "user", content: userMsg \}\
                        ],\
                        temperature: 0.3\
                    \})\
                \});\
                const data = await res.json();\
                \
                document.getElementById(loadingId).remove();\
                addChatMessage('agent', data.choices[0].message.content);\
            \} catch (err) \{\
                document.getElementById(loadingId).remove();\
                addChatMessage('agent', '\uc0\u25265 \u27465 \u65292 \u22238 \u31572 \u22833 \u36133 \u65292 \u35831 \u26816 \u26597 \u32593 \u32476 \u25110  API \u35774 \u32622 \u12290 ');\
            \}\
        \}\
\
        document.getElementById('chat-input').addEventListener('keydown', function(e) \{\
            if (e.key === 'Enter' && !e.shiftKey) \{\
                e.preventDefault();\
                sendChatMessage();\
            \}\
        \});\
    </script>\
</body>\
