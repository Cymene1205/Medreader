# =============================================================================
# MedReader Agent — Production Environment Variables Template
# =============================================================================
# Copy to .env.production and fill in your real values:
#   cp .env.production.example .env.production
#   vi .env.production
#
# .env.production is gitignored — NEVER commit real secrets.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite file path inside the container. Mapped to ./data/custom.db on host
# via docker-compose volumes.
DATABASE_URL=file:/app/data/custom.db

# --- File uploads -----------------------------------------------------------
# Where uploaded PDFs + MinerU-extracted images are stored.
# MUST match the volume mount in docker-compose.yml.
# The Dockerfile also sets this as a default; setting it here too makes the
# config explicit and lets you override it (e.g. to use a different volume).
UPLOADS_DIR=/app/uploads

# --- NextAuth ---------------------------------------------------------------
# Generate a random 32-byte secret:
#   openssl rand -base64 32
NEXTAUTH_SECRET=PLEASE_REPLACE_WITH_RANDOM_32_BYTES

# Public URL of the deployment. Used by NextAuth for callback URLs.
# Update this once you have a domain (e.g. https://medreader.example.com).
NEXTAUTH_URL=http://YOUR-SERVER-IP:3000

# --- MinerU Cloud API (PDF parsing) -----------------------------------------
# Get your token at https://mineru.net → API Management → Create Token
# Without this, PDF upload will fail with auth error.
MINERU_API_TOKEN=sk-YOUR-MINERU-TOKEN

# --- DeepSeek LLM API (chat / Q&A) ------------------------------------------
# Get your key at https://platform.deepseek.com → API Keys → Create
# Without this, Agent Q&A and structured analysis will fail.
DEEPSEEK_API_KEY=sk-YOUR-DEEPSEEK-KEY

# --- Vision (figure Q&A) — Zhipu GLM-4V -------------------------------------
# Used by /api/vision (框图提问) and /api/vision-test.
# These are SERVER-SIDE DEFAULTS — users can override per-browser via the
# "模型设置 → 图像识别" tab in the UI (config stored in localStorage, sent
# as X-Vision-* headers). The env values are used when a user has NOT filled
# in the vision tab.
#
# Get your key at https://open.bigmodel.cn → API Keys → Create
# Default model glm-4v-flash is free tier; switch to glm-4v / glm-4.5v if you
# need stronger image understanding.
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=ab99-YOUR-ZHIPU-KEY
VISION_MODEL=glm-4v-flash

# --- Optional: alternative LLM providers ------------------------------------
# Uncomment and fill in to enable additional providers in the chat UI.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-flash
#
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k

# --- Optional: file upload limits -------------------------------------------
# Override the 50 MB default (must match next.config.ts middlewareClientMaxBodySize
# and serverActions.bodySizeLimit if changed).
# MAX_UPLOAD_BYTES=52428800
