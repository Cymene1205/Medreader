// Prisma schema for MedReader Agent
// Combines models from features 1, 2, 3 (auth, statistics, paper upload)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  role         String       @default("user") // "user" | "admin"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  accounts     Account[]
  sessions     Session[]
  chatLogs     ChatLog[]
  feedbacks    Feedback[]
  events       UsageEvent[]
  papers       Paper[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Paper {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  filePath    String
  parseStatus String   @default("pending") // pending | done | error
  parsedText  String?  // Plain-text fallback (pdfjs)
  markdown    String?  // MinerU full.md content (knowledge base)
  blocksJson  String?  // JSON-stringified MinerU content_list.json (block-level: page_idx/bbox/text_level)
  imagesDir   String?  // local dir for extracted images
  mineruTaskId  String? // MinerU batch_id or task_id
  pageCount   Int?
  createdAt   DateTime @default(now())
  chatLogs    ChatLog[]
}

model ChatLog {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  paperId    String?
  paper      Paper?     @relation(fields: [paperId], references: [id], onDelete: SetNull)
  question   String
  answer     String
  paperTitle String?
  createdAt  DateTime   @default(now())
  feedbacks  Feedback[]
}

model Feedback {
  id        String   @id @default(cuid())
  chatLogId String
  chatLog   ChatLog  @relation(fields: [chatLogId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // "up" | "down"
  reason    String?
  createdAt DateTime @default(now())

  @@unique([chatLogId, userId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // login | upload_pdf | analyze | chat | translate | vision | followups | mineru_parse
  meta      String?
  createdAt DateTime @default(now())
}

// Daily quota tracking — one row per (user, day, action).
// We cap per-user-per-day uploads (mineru quota) AND chat/translate calls.
model DailyQuota {
  id        String   @id @default(cuid())
  userId    String?  // null = anonymous (identified by ip+ua hash stored in meta)
  action    String   // "mineru_parse" | "chat" | "translate" | "vision"
  day       String   // YYYY-MM-DD (UTC+8)
  count     Int      @default(0)
  meta      String?  // ip hash / extra info
  updatedAt DateTime @updatedAt

  @@unique([userId, action, day])
  @@index([action, day])
}

// Per-call LLM token usage + estimated cost — populated by src/lib/llm.ts
// for every callLLM / streamLLM / callVisionLLM invocation.
// Used by the admin dashboard to show token consumption and estimate cost.
model TokenUsage {
  id               String   @id @default(cuid())
  userId           String?  // null = anonymous
  action           String   // "analyze" | "chat" | "translate" | "vision" | "followups" | "llm_test"
  provider         String   // "deepseek" | "openai" | "zhipu" | "moonshot" | "anthropic" | "custom"
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costCny          Float    @default(0)  // estimated cost in CNY (RMB)
  paperId          String?
  createdAt        DateTime @default(now())

  @@index([action, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
}
