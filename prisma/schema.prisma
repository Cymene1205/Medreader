// Prisma schema for MedReader Agent
// Combines models from features 1, 2, 3 (auth, statistics, paper upload)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  role         String       @default("user") // "user" | "admin"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  accounts     Account[]
  sessions     Session[]
  chatLogs     ChatLog[]
  feedbacks    Feedback[]
  events       UsageEvent[]
  papers       Paper[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Paper {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  filePath    String
  parseStatus String   @default("pending") // pending | done | error
  parsedText  String?
  createdAt   DateTime @default(now())
  chatLogs    ChatLog[]
}

model ChatLog {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  paperId    String?
  paper      Paper?     @relation(fields: [paperId], references: [id], onDelete: SetNull)
  question   String
  answer     String
  paperTitle String?
  createdAt  DateTime   @default(now())
  feedbacks  Feedback[]
}

model Feedback {
  id        String   @id @default(cuid())
  chatLogId String
  chatLog   ChatLog  @relation(fields: [chatLogId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // "up" | "down"
  reason    String?
  createdAt DateTime @default(now())

  @@unique([chatLogId, userId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // login | upload_pdf | analyze | chat | translate | vision | followups
  meta      String?
  createdAt DateTime @default(now())
}
